{
  "name": "bszz-dojo",
  "version": "3.18.2",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "storybook": "npm run storybook -w web",
    "build-storybook": "turbo run build-storybook --filter=web",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,html,css,json,md}\""
  },
  "devDependencies": {
    "oxlint": "^1.24.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
