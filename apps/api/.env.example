# Copy to .env and fill in. Never commit .env.

# Postgres connection string. Locally: the dev database (Neon branch) or a local Postgres.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional: direct (non-pgbouncer) URL for migrations, e.g. Neon's unpooled URL.
DATABASE_URL_UNPOOLED=

# Secret for signing access tokens. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Browser origin(s) allowed to call the API, comma separated.
CORS_ORIGIN=http://localhost:4200

# The refresh token cookie is Secure (HTTPS only) unless this is false. Local dev runs on http.
COOKIE_SECURE=false

PORT=3000

# Only for `npm run legacy:import -w api`: the old PHP app's MySQL database.
LEGACY_MYSQL_URL=mysql://root:@localhost:3306/bszzDojo
