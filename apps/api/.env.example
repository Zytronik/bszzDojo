# Copy to .env and fill in. Never commit .env.

# Postgres connection string. Locally: the dev database (Neon branch) or a local Postgres.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional: direct (non-pgbouncer) URL for migrations, e.g. Neon's unpooled URL.
DATABASE_URL_UNPOOLED=

# Secret for signing access tokens. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# The refresh token cookie is Secure (HTTPS only) unless this is false. Local dev runs on http.
COOKIE_SECURE=false

PORT=3000

# Push messages (duels). Generate a key pair with: npm run push:keys -w api (the web-push CLI)
# The subject is a contact the push services can reach (mailto: or https:). Without these three,
# the API sends no push messages and the app doesn't offer them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
