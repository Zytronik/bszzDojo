{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run swagger:metadata && nest build",
    "dev": "npm run swagger:metadata && npm run migration:run && nest start --watch",
    "typecheck": "npm run swagger:metadata && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "rm -rf dist .turbo",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:deploy": "typeorm migration:run -d dist/database/data-source.js",
    "swagger:metadata": "ts-node --transpile-only scripts/swagger-metadata.ts"
  },
  "dependencies": {
    "@bszz-dojo/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
