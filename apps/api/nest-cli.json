{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": [".body.ts", ".query.ts", ".response.ts"],
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  }
}
