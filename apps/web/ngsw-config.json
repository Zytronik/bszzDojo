{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/img/**", "/fonts/**"]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api",
    "!/api/**",
    "!/api-json"
  ],
  "dataGroups": [
    {
      "name": "api-reads",
      "urls": ["/api/rankings", "/api/profiles/**", "/api/scores/*"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 200,
        "maxAge": "30d"
      }
    }
  ]
}
