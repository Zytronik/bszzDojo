{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "angular",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npx turbo run build --filter=web",
      "outputDirectory": "dist/web/browser",
      "headers": [
        {
          "source": "/(ngsw-worker.js|ngsw.json|safety-worker.js|manifest.webmanifest|index.html)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ],
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npx turbo run build --filter=api && npm run migration:deploy -w api"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "api" } },
    { "source": "/api-json", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
